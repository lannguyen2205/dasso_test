# Keycloak server (local docker: http://localhost:8080)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=dasso
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=app-b

# Backend Server B URL (use NEXT_PUBLIC_SERVER_B_URL or fallback NEXT_PUBLIC_SERVER_URL)
NEXT_PUBLIC_SERVER_B_URL=http://localhost:4002
NEXT_PUBLIC_SERVER_URL=http://localhost:4002

# URL of the other app, used for the "open App A" SSO test link
NEXT_PUBLIC_OTHER_APP_URL=http://localhost:3001
