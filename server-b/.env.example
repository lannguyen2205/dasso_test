# DaSSO Server B Environment Configuration
PORT=4002
APP_NAME=DaSSO Backend B

# Optional: Real Email Dispatch via Gmail App Password or SMTP
# If omitted, verification OTP will be printed to console log and returned in test payload
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional Custom SMTP Server (e.g. Mailgun, SendGrid, Mailtrap)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Frontend Client Origin
CLIENT_ORIGIN=http://localhost:3002
