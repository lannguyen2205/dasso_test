# Keycloak server (local docker: http://localhost:8080)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=dasso
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=app-a

# Backend Server A URL (use NEXT_PUBLIC_SERVER_A_URL or fallback NEXT_PUBLIC_SERVER_URL)
NEXT_PUBLIC_SERVER_A_URL=http://localhost:4001
NEXT_PUBLIC_SERVER_URL=http://localhost:4001

# URL of the other app, used for the "open App B" SSO test link
NEXT_PUBLIC_OTHER_APP_URL=http://localhost:3002
